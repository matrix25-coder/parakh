# PARAKH REGULATORY SYSTEM — ENVIRONMENT CONFIGURATION

# [Optional] Google Gemini Multimodal Vision API Key for high-accuracy OCR & label extraction
# If not provided, Parakh automatically uses the built-in local Tesseract OCR engine.
GEMINI_API_KEY=

# [Optional] Cryptographic secret for signing session authentication tokens
# If not provided, an internal fallback secret key is used in development.
AUTH_SECRET=REDACTED_AUTH_SECRET

# [Optional] Database URL (SQLite is used out-of-the-box in data/parakh.db without configuration)
DATABASE_URL=file:./data/parakh.db

# [Android / Mobile Backend Reachability]
# Set when running on an Android device/emulator or separate frontend host.
# Development: http://192.168.1.X:3000 (LAN IP) or http://10.0.2.2:3000 (Android Studio emulator)
# Production: https://YOUR-PARAKH-BACKEND
NEXT_PUBLIC_API_BASE_URL=
CAPACITOR_SERVER_URL=
