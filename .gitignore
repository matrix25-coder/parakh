# ─── Node.js ─────────────────────────────────────────────────────────────────
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# ─── Testing / Coverage ──────────────────────────────────────────────────────
/coverage

# ─── Next.js build outputs ───────────────────────────────────────────────────
.next/
out/

# ─── Production build ────────────────────────────────────────────────────────
build/
dist/

# ─── Environment & secrets ───────────────────────────────────────────────────
# Ignore ALL .env variants EXCEPT the safe placeholder example file
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging

# ─── Private keys & certificates ─────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
service-account*.json
google-services.json

# ─── Debug & logs ────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ─── OS artefacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Vercel / tooling ────────────────────────────────────────────────────────
.vercel/
.reticle/

# ─── TypeScript build info ───────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Local SQLite database (contains real inspection records & PII) ──────────
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite3

# ─── Uploaded inspection images (may contain personal/PII data) ──────────────
public/uploads/*
!public/uploads/.gitkeep
# Allow committed sample/demo images only
!public/uploads/wellcore_*.jpg
!public/uploads/sample_*.jpg

# ─── OCR model data (large binary, not source code) ──────────────────────────
*.traineddata

# ─── Android build artefacts ─────────────────────────────────────────────────
android/.gradle/
android/app/build/
android/build/
android/.idea/
android/*.iml
android/app/*.iml
android/local.properties
android/captures/
android/.externalNativeBuild/
android/.cxx/
# Firebase / Google Services config (contains API keys)
android/app/google-services.json

# ─── Capacitor / Cordova generated ───────────────────────────────────────────
.capacitor/

# ─── Temporary / scratch files ───────────────────────────────────────────────
*.tmp
*.bak
*.swp
.cache/
